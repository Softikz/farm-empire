import tkinter as tk
import random

# --- Конфети ---
confetti_particles = []

def create_confetti(canvas):
    """Создаёт частицы конфети сверху окна."""
    colors = ["red", "blue", "green", "yellow", "purple", "orange", "pink", "cyan"]
    for _ in range(80):
        x = random.randint(0, 600)
        y = random.randint(-300, -10)
        size = random.randint(5, 12)
        color = random.choice(colors)
        shape = random.choice(["oval", "rect"])
        if shape == "oval":
            item = canvas.create_oval(x, y, x + size, y + size, fill=color, outline="")
        else:
            item = canvas.create_rectangle(x, y, x + size, y + size, fill=color, outline="")
        speed = random.uniform(3, 9)
        drift = random.uniform(-1.5, 1.5)
        confetti_particles.append({"id": item, "speed": speed, "drift": drift})

def animate_confetti(canvas, root):
    """Анимация падения конфети."""
    still_falling = False
    for p in confetti_particles:
        if p["id"] is None:
            continue
        canvas.move(p["id"], p["drift"], p["speed"])
        pos = canvas.coords(p["id"])
        if pos and pos[1] < 700:
            still_falling = True
        else:
            canvas.delete(p["id"])
            p["id"] = None
    if still_falling:
        root.after(20, lambda: animate_confetti(canvas, root))
    else:
        confetti_particles.clear()

def on_yes(canvas, root):
    """Обработчик кнопки Да — запускает конфети."""
    create_confetti(canvas)
    animate_confetti(canvas, root)

# --- Убегающая кнопка Нет ---
def move_no_button(event, button, root):
    """Перемещает кнопку Нет в случайное место при наведении."""
    win_w = root.winfo_width()
    win_h = root.winfo_height()
    btn_w = button.winfo_width()
    btn_h = button.winfo_height()

    # Ограничиваем область, чтобы кнопка не улетела за пределы окна
    max_x = max(10, win_w - btn_w - 10)
    max_y = max(10, win_h - btn_h - 10)

    new_x = random.randint(10, max_x)
    new_y = random.randint(10, max_y)

    button.place(x=new_x, y=new_y)

# --- Основное окно ---
root = tk.Tk()
root.title("Голосование")
root.geometry("600x400")
root.resizable(False, False)

# Canvas для конфети (на заднем плане)
canvas = tk.Canvas(root, width=600, height=400, highlightthickness=0)
canvas.place(x=0, y=0)

# Вопрос
question = tk.Label(root, text="ВЫ ГОЛОСУЕТЕ ЗА ЕР?", font=("Arial", 22, "bold"), bg="white")
question.place(relx=0.5, y=60, anchor="center")

# Кнопка Да
btn_yes = tk.Button(root, text="Да", font=("Arial", 16, "bold"),
                    bg="#4CAF50", fg="white", width=10,
                    command=lambda: on_yes(canvas, root))
btn_yes.place(relx=0.3, rely=0.75, anchor="center")

# Кнопка Нет (убегающая)
btn_no = tk.Button(root, text="Нет", font=("Arial", 16, "bold"),
                   bg="#f44336", fg="white", width=10)
btn_no.place(relx=0.7, rely=0.75, anchor="center")

# Привязываем событие наведения мыши
btn_no.bind("<Enter>", lambda event: move_no_button(event, btn_no, root))

root.mainloop()
